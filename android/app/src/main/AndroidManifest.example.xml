<?xml version="1.0" encoding="utf-8"?>
<!--
  ده مثال توضيحي بس عشان تعرف "فين" تضيف صلاحيات الموقع بالظبط -
  مش ملف جاهز للاستخدام المباشر، ومش نسخة من ملفك الحقيقي. ملفك
  الأصلي موجود على المسار: android/app/src/main/AndroidManifest.xml
  وفيه بالفعل إعدادات تانية (اسم الباكدج، صلاحيات بلجنز تانية،
  الأيقونة..إلخ) - متستبدلش الملف بالكامل بالمثال ده، بس ضيف سطرين
  الموقع (ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION) جوه ملفك
  الحقيقي في نفس الترتيب الظاهر هنا (قبل <application> مباشرة).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ⬇️ ده السطرين المطلوب إضافتهم - حطهم مع أي <uses-permission>
         تانية موجودة عندك أصلاً (لو فيه)، قبل وسم <application> -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- أي <uses-permission> تانية كانت موجودة عندك أصلاً (كاميرا،
         إشعارات..إلخ) تفضل زي ما هي بالظبط - متمسحهاش -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- محتوى <application> الحقيقي عندك (الـ Activity الرئيسية،
             الـ FileProvider، أي meta-data لبلجنز..إلخ) يفضل زي ما هو
             تمامًا - مش جزء من التعديل ده خالص -->

    </application>

</manifest>
